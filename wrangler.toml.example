# Copy this file to wrangler.toml and fill in your values.
# wrangler.toml is gitignored — it holds your personal Cloudflare
# account binding and is never committed.

name = "portage"
main = "src/index.ts"
# Pinned to local-runtime max; production accepts later dates. Bump after wrangler upgrade.
compatibility_date = "2024-12-30"
compatibility_flags = ["nodejs_compat"]
account_id = "<YOUR_CLOUDFLARE_ACCOUNT_ID>"

# Bind the Worker to your custom domain. Replace <YOUR_WORKER_DOMAIN> with the
# hostname you've configured in Cloudflare (e.g. portage.example.com). The
# domain must already exist in your Cloudflare account; `custom_domain = true`
# tells wrangler to provision the DNS record + SSL automatically.
routes = [
  { pattern = "<YOUR_WORKER_DOMAIN>", custom_domain = true }
]

# Holds the copy engine's advisory active-job flag. The */5 tick reads this
# instead of Neon, so an idle heartbeat never wakes the autosuspended compute.
# Neon's free plan suspends only after 5 minutes of inactivity and that timeout
# is not configurable, so the old one-query-per-tick fast path held the compute
# awake 99.7% of wall clock and burned 86 of the 100 monthly CU-hours in 13 days.
# Create your own with
#   npx wrangler kv namespace create COPY_STATE
# and paste the printed id below. The flag is a cache of copy_jobs, never a
# source of truth: without this binding the Worker still runs correctly, just at
# the old cost of one Neon query per tick.
[[kv_namespaces]]
binding = "COPY_STATE"
id = "<YOUR_KV_NAMESPACE_ID>"

# Steady-state mode (2x daily UTC) per F-010. Backfill drained 2026-05-04 ~09:30 UTC
# (truly_unprocessed = 0 via LEFT JOIN on tracks/matches/unmatched). Re-enable
# */15 backfill if Liked Songs queue grows back into a backlog.
#
# F-030 (playlist-copy) D1: a third schedule drives runCopyTick — 288
# invocations/day (0.3% of the request quota); the handler exits without
# touching Neon when the COPY_STATE flag is absent. scheduled.ts dispatches on
# controller.cron: the two existing expressions keep calling runSync
# unchanged. Workers free tier allows up to 5 cron schedules per account —
# verify no other Worker on the account already uses the remaining slots
# before deploying (design.md Risks).
[triggers]
crons = ["23 7 * * *", "23 19 * * *", "*/5 * * * *"]

[vars]
TIDAL_COUNTRY_CODE = "RO"
TIDAL_PLAYLIST_TITLE = "Spotify Liked"
SPOTIFY_REDIRECT_URI = "https://<YOUR_WORKER_DOMAIN>/auth/spotify/callback"
TIDAL_REDIRECT_URI = "https://<YOUR_WORKER_DOMAIN>/auth/tidal/callback"
OPERATOR_EMAIL = "<YOUR_EMAIL>"
UI_ORIGIN = "<YOUR_UI_ORIGIN>"

# Per-invocation match-queue caps. Defaults in src/sync/orchestrator.ts are 5
# each (DEFAULT_MATCH_BATCH_ISRC / DEFAULT_MATCH_BATCH_FUZZY). Reduced to 2
# to stay well inside the Workers free-tier CPU + subrequest budget; without
# this clamp ~36% of crons over the prior 14d window were silent-abandoned
# (CF terminated the isolate before runSync's catch could record an error
# code, so the row sat at status='running' until markAbandonedRuns swept it
# 12 h later). The queue drains more slowly, but every run completes.
MATCH_BATCH_ISRC = "2"
MATCH_BATCH_FUZZY = "2"

# F-030: same free-tier conservatism for the copy-job engine's matching
# phase (design.md D6). Defaults in src/copy/engine.ts are already 2 each;
# set explicitly here for parity with MATCH_BATCH_* above.
COPY_BATCH_ISRC = "2"
COPY_BATCH_FUZZY = "2"


# F-019: Cloudflare Access JWT validation. Both values are public — TEAM is
# visible in the CF Access redirect URL, AUD is part of every CF Access JWT's
# `aud` claim. Kept in [vars] rather than `wrangler secret put` so changes go
# through PR review.
CF_ACCESS_TEAM = "<YOUR_CF_ACCESS_TEAM>"
CF_ACCESS_AUD = "<YOUR_CF_ACCESS_AUD>"

[observability]
[observability.logs]
enabled = true
invocation_logs = true
