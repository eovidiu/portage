# Copy this file to .dev.vars and fill in real values from .env or 1Password.
# .dev.vars is gitignored and must never be committed.

DATABASE_URL=PLACEHOLDER
JWT_SECRET=PLACEHOLDER
TOKEN_ENCRYPTION_KEY=PLACEHOLDER
SPOTIFY_CLIENT_ID=PLACEHOLDER
SPOTIFY_CLIENT_SECRET=PLACEHOLDER
SPOTIFY_REDIRECT_URI=PLACEHOLDER
TIDAL_CLIENT_ID=PLACEHOLDER
TIDAL_CLIENT_SECRET=PLACEHOLDER
TIDAL_REDIRECT_URI=PLACEHOLDER
TIDAL_COUNTRY_CODE=PLACEHOLDER
TIDAL_PLAYLIST_TITLE=PLACEHOLDER
# Test-only: overrides orchestrator 300s wall-time cap (used by T-009-10 e2e test).
# Set to 1 to ensure the timeout fires before any provider call returns.
WALL_TIME_OVERRIDE_MS=1
