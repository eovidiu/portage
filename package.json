{
  "name": "portage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "test:e2e": "bash scripts/run-e2e.sh",
    "gen:tidal-types": "openapi-typescript https://tidal-music.github.io/tidal-api-reference/tidal-api-oas.json -o src/providers/tidal/openapi-types.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "hono": "^4.0.0",
    "jose": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@vitest/coverage-istanbul": "^2.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "wrangler": "3.99.0"
  }
}
